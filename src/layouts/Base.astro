---
// Base layout — the <head> contract copied from the LIVE served page
// (tech-truth/home.html), plus the theme's global stylesheets.
//
// Fidelity law: this file reproduces the WordPress head; it does not improve on it.
// theme.css is the byte-identical style.css imported ONCE so the original cascade holds.
import '../styles/fonts.css';
import '../styles/theme.css';
import '../styles/premium-borders.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import MobileTabBar from '../components/MobileTabBar.astro';
import { SITE } from '../data/nav';
import { url, absUrl } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  bodyClass?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  canonical,
  ogImage = '/og-default.png',
  ogType = 'article',
  bodyClass = '',
} = Astro.props;

const site = Astro.site ?? new URL('https://godschi10.github.io');
const canonicalHref = canonical ?? absUrl(Astro.url.pathname.replace(import.meta.env.BASE_URL, '/'), site);
const ogImageAbs = absUrl(ogImage, site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover" />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href={url('/fonts/jetbrains-mono-latin-400.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="dns-prefetch" href="https://secure.gravatar.com" />
    <link rel="preconnect" href="https://secure.gravatar.com" crossorigin />

    <title>{title}</title>
    <meta name="robots" content="max-image-preview:large" />

    <meta name="description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} » Feed`} href={url('/rss.xml')} />
    <link rel="canonical" href={canonicalHref} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: SITE.title,
      url: site.href,
      logo: { '@type': 'ImageObject', url: absUrl('/assets/brand/favicon.svg', site) },
      description: 'Android tutorials and web engineering, tested first.',
      sameAs: [
        'https://github.com/godschi10',
        'https://x.com/godschi10',
        'https://youtube.com/@gwillchijioke',
        'https://www.pinterest.com/gwillchijioke/',
        'https://www.threads.net/@gwillchijioke',
      ],
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE.title,
      url: site.href,
      potentialAction: {
        '@type': 'SearchAction',
        target: { '@type': 'EntryPoint', urlTemplate: `${site.href}?s={search_term_string}` },
        'query-input': 'required name=search_term_string',
      },
    })} />

    <link rel="icon" type="image/svg+xml" href={url('/assets/brand/favicon.svg')} />
    <link rel="apple-touch-icon" sizes="180x180" href={url('/assets/brand/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <meta name="application-name" content={SITE.title} />
    <meta name="mobile-web-app-capable" content="yes" />


    <!-- theme scripts, ported verbatim; deferred like the theme's own enqueue -->
    <script is:inline defer src={url('/js/hero-carousel.js')}></script>
    <script is:inline defer src={url('/js/main.js')}></script>
    <script is:inline defer src={url('/js/cookie-consent-simple.js')}></script>
    <script is:inline defer src={url('/js/code-copy.js')}></script>
    <script is:inline defer src={url('/js/lightbox.js')}></script>
    <script is:inline defer src={url('/js/reading-progress.js')}></script>
    <script is:inline defer src={url('/js/sticky-ad.js')}></script>
    <script is:inline defer src={url('/js/embed-facades.js')}></script>
    <script is:inline defer src={url('/js/premium.js')}></script>
    <script is:inline define:vars={{ searchIndexUrl: url('/search-index.json'), searchPageUrl: url('/search/') }}>
      window.GwillDropdown = {
        indexUrl: searchIndexUrl,
        homeUrl: searchPageUrl,
        i18n: {
          loading: 'Searching…',
          noResults: 'No results found.',
          noMatches: 'No matches for “%s” — try these recent guides:',
          error: 'Search unavailable. Please try again.',
          viewAll: 'View all results →'
        }
      };
    </script>
    <script is:inline defer src={url('/js/search-dropdown.js')}></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div id="vp">
    <a class="skip-link" href="#content">Skip to content</a>
    <CookieBanner />
    <Header />
    <main id="content" class="site-main">
      <slot />
    </main>
    <Footer />
    </div>
    <MobileTabBar />
  </body>
</html>
