  "body": "\n<article class=\"page-tools-tool\" itemscope itemtype=\"https://schema.org/WebPage\">\n<!-- ═══ 2. tool hero ═══ -->\n<section class=\"section-sm\" style=\"padding-top:var(--sp-6);padding-bottom:0;position:relative\">\n<div class=\"wrap\" style=\"max-width:var(--content-w)\">\n<nav class=\"breadcrumb\" style=\"margin-bottom:var(--sp-4)\" aria-label=\"Breadcrumb\">\n<ol class=\"breadcrumb-list\">\n<li><a href=\"%BASE%/\" class=\"bc-home-link\"><span class=\"bc-prompt\">&gt;_</span>Home</a></li>\n<li><a href=\"%BASE%/tools/\">Tools</a></li>\n<li><span class=\"breadcrumb-current\" aria-current=\"page\">wp-config.php Generator</span></li>\n</ol>\n</nav>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://gwillchijioke.qzz.io/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Tools\",\"item\":\"https://gwillchijioke.qzz.io/tools/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"wp-config.php Generator\",\"item\":\"https://gwillchijioke.qzz.io/tools/wp-config-generator/\"}]}</script>\n<div class=\"about-hero\" style=\"margin-bottom:var(--sp-6)\">\n<p class=\"label label-green\">&gt;_ tools --wp-config</p>\n<div class=\"about-intro\">\n<div class=\"about-text\">\n<h1 style=\"font-size:clamp(28px,4vw,44px);font-weight:800;line-height:1.1;margin:16px 0;letter-spacing:-.03em\">wp-config.php Generator</h1>\n<p style=\"font-size:17px;color:var(--mid);line-height:1.7;max-width:56ch\">\n\t\t\t\t\t\t\tGenerate a complete wp-config.php - MySQL or SQLite, random salts, debug &amp; performance constants, and free-tier hardening. Everything runs in your browser; nothing is uploaded.\t\t\t\t\t\t</p>\n</div>\n</div>\n</div>\n<div class=\"ad-slot ad-slot--leaderboard\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n<!-- ═══ 3. tool behaviour (wp-config.php generator) ═══ -->\n<div id=\"wpc-app\" style=\"max-width:var(--content-w)\">\n<div class=\"wpc-wrap\">\n<section class=\"wpc-card\">\n<div class=\"wpc-grid\">\n<div class=\"wpc-side\">\n<!-- DB type -->\n<div class=\"wpc-sec\"><span class=\"dot\"></span><h3>Database</h3></div>\n<label class=\"wpc-field\">\n<span class=\"wpc-lbl\">Database type</span>\n<select class=\"wpc-in\" id=\"wpc-db\">\n<option value=\"mysql\">MySQL / MariaDB</option>\n<option value=\"sqlite\">SQLite (SQLite Database Integration)</option>\n</select>\n</label>\n<label class=\"wpc-chk\" style=\"margin-top:2px\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-sqlite\"> Use SQLite (the moat)</label>\n<!-- DB_NAME (shared) -->\n<label class=\"wpc-field\" style=\"margin-top:10px\"><span class=\"wpc-lbl\">DB_NAME</span>\n<input class=\"wpc-in\" id=\"wpc-dbName\" type=\"text\" value=\"wordpress\" placeholder=\"wordpress\"></label>\n<!-- MySQL-only fields -->\n<div id=\"wpc-mysqlFields\" class=\"wpc-field\" style=\"margin-top:10px\">\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_HOST</span>\n<input class=\"wpc-in\" id=\"wpc-dbHost\" type=\"text\" value=\"localhost\" placeholder=\"localhost\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_USER</span>\n<input class=\"wpc-in\" id=\"wpc-dbUser\" type=\"text\" value=\"wp_user\" placeholder=\"wp_user\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_PASSWORD</span>\n<input class=\"wpc-in\" id=\"wpc-dbPass\" type=\"text\" placeholder=\"your password\"></label>\n</div>\n<!-- SQLite-only fields (authoritative: DB_DIR + DB_FILE) -->\n<div id=\"wpc-sqliteFields\" class=\"wpc-field\" style=\"margin-top:10px\" hidden>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_DIR (database folder)</span>\n<input class=\"wpc-in\" id=\"wpc-dbDir\" type=\"text\" placeholder=\"default: WP_CONTENT_DIR . '/database'\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_FILE (the .sqlite file)</span>\n<input class=\"wpc-in\" id=\"wpc-dbFile\" type=\"text\" value=\".ht.sqlite\" placeholder=\".ht.sqlite\"></label>\n</div>\n<!-- prefix + charset -->\n<div class=\"wpc-pair\" style=\"margin-top:10px\">\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">Table prefix</span>\n<input class=\"wpc-in\" id=\"wpc-prefix\" type=\"text\" value=\"wp_\" placeholder=\"wp_\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_CHARSET</span>\n<input class=\"wpc-in\" id=\"wpc-charset\" type=\"text\" value=\"utf8\" placeholder=\"utf8\"></label>\n</div>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">DB_COLLATE (MySQL only)</span>\n<input class=\"wpc-in\" id=\"wpc-collate\" type=\"text\" placeholder=\"leave empty\"></label>\n<!-- memory -->\n<div class=\"wpc-sec\" style=\"margin-top:14px\"><span class=\"dot\"></span><h3>Memory limits (free-tier)</h3></div>\n<div class=\"wpc-pair\">\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">WP_MEMORY_LIMIT</span>\n<input class=\"wpc-in\" id=\"wpc-memlimit\" type=\"text\" value=\"64M\" placeholder=\"64M\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">WP_MAX_MEMORY_LIMIT</span>\n<input class=\"wpc-in\" id=\"wpc-maxmem\" type=\"text\" value=\"256M\" placeholder=\"256M\"></label>\n</div>\n</div>\n<div class=\"wpc-side\">\n<!-- debug -->\n<div class=\"wpc-sec\"><span class=\"dot\"></span><h3>Debug</h3></div>\n<div class=\"wpc-chk-grid\">\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-debug\"> WP_DEBUG</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-debuglog\"> WP_DEBUG_LOG</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-debugdisplay\"> WP_DEBUG_DISPLAY</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-scriptdebug\"> SCRIPT_DEBUG</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-savequeries\"> SAVEQUERIES</label>\n</div>\n<!-- hardening -->\n<div class=\"wpc-sec\" style=\"margin-top:14px\"><span class=\"dot\"></span><h3>Hardening</h3></div>\n<div class=\"wpc-chk-grid\">\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-disfileedit\" checked> DISALLOW_FILE_EDIT</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-disfilemods\"> DISALLOW_FILE_MODS</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-autoupdates\"> AUTOMATIC_UPDATER_DISABLED</label>\n<label class=\"wpc-chk\"><input type=\"checkbox\" class=\"wpc-in-chk\" id=\"wpc-cron\"> DISABLE_WP_CRON</label>\n</div>\n<!-- perf -->\n<div class=\"wpc-sec\" style=\"margin-top:14px\"><span class=\"dot\"></span><h3>Performance</h3></div>\n<div class=\"wpc-pair\">\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">WP_POST_REVISIONS</span>\n<input class=\"wpc-in\" id=\"wpc-revisions\" type=\"number\" value=\"5\" placeholder=\"5\"></label>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">AUTOSAVE_INTERVAL (sec)</span>\n<input class=\"wpc-in\" id=\"wpc-autosave\" type=\"number\" value=\"120\" placeholder=\"120\"></label>\n</div>\n<label class=\"wpc-field\" style=\"margin-top:10px\"><span class=\"wpc-lbl\">FS_METHOD</span>\n<select class=\"wpc-in\" id=\"wpc-fsmethod\">\n<option value=\"\">(leave default)</option>\n<option value=\"direct\">direct</option>\n<option value=\"ftpext\">ftpext</option>\n<option value=\"ssh2\">ssh2</option>\n</select></label>\n<!-- locale -->\n<div class=\"wpc-sec\" style=\"margin-top:14px\"><span class=\"dot\"></span><h3>Site locale</h3></div>\n<label class=\"wpc-field\"><span class=\"wpc-lbl\">WPLANG (leave empty for English)</span>\n<input class=\"wpc-in\" id=\"wpc-lang\" type=\"text\" placeholder=\"e.g. en_GB\" value=\"\"></label>\n</div>\n</div>\n<div class=\"wpc-btnrow\">\n<button type=\"button\" class=\"wpc-btn wpc-p\" id=\"wpc-regen\">Generates new salts</button>\n<span class=\"wpc-privacy\"><span class=\"wpc-dot\"></span> generated entirely on your device - nothing is uploaded</span>\n</div>\n</section>\n<!-- output -->\n<section class=\"wpc-card\">\n<div class=\"wpc-outcap\"><span>generated wp-config.php</span><span class=\"line\"></span><span id=\"wpc-byteCount\" style=\"color:var(--dim)\">0 B</span></div>\n<div class=\"wpc-outbox\">\n<div class=\"wpc-out\"><code id=\"wpc-out\"></code></div>\n<div class=\"wpc-btnrow\">\n<button type=\"button\" class=\"wpc-btn wpc-p\" id=\"wpc-copy\">Copy wp-config.php</button>\n<button type=\"button\" class=\"wpc-btn\" id=\"wpc-dl\">Download wp-config.php</button>\n</div>\n<div class=\"wpc-msg\" id=\"wpc-msg\" role=\"alert\" hidden></div>\n</div>\n</section>\n<!-- ═══ related tools (6-point law #3) ═══ -->\n<section class=\"wpc-related\" aria-labelledby=\"wpc-related-h\">\n<h2 id=\"wpc-related-h\" class=\"wpc-related-h\">&gt;_ Related tools</h2>\n<div class=\"wpc-related-grid\">\n<a class=\"wpc-rel-card\" href=\"%BASE%/tools/htaccess-generator/\">\n<span class=\"wpc-rel-name\">.htaccess Generator</span>\n<span class=\"wpc-rel-desc\">Pair the config with Apache-level hardening.</span>\n</a>\n<a class=\"wpc-rel-card\" href=\"%BASE%/tools/cron-expression-generator/\">\n<span class=\"wpc-rel-name\">Cron Expression Generator</span>\n<span class=\"wpc-rel-desc\">Where DISABLE_WP_CRON gets a real schedule.</span>\n</a>\n<a class=\"wpc-rel-card\" href=\"%BASE%/tools/sqlite-mysql-converter/\">\n<span class=\"wpc-rel-name\">SQLite ⇄ MySQL Converter</span>\n<span class=\"wpc-rel-desc\">Move queries between the two engines the config supports.</span>\n</a>\n<a class=\"wpc-rel-card\" href=\"%BASE%/tools/password-generator/\">\n<span class=\"wpc-rel-name\">Password Generator</span>\n<span class=\"wpc-rel-desc\">The DB_PASSWORD the config asks you for.</span>\n</a>\n</div>\n</section>\n<!-- ═══ visible FAQ (6-point law #2 - mirrors the FAQPage schema byte-exact) ═══ -->\n<section class=\"wpc-faq\" aria-labelledby=\"wpc-faq-h\">\n<h2 id=\"wpc-faq-h\" class=\"wpc-faq-h\">&gt;_ FAQ</h2>\n<details class=\"wpc-faq-item\">\n<summary>What is different about this wp-config generator?</summary>\n<p>It can generate a wp-config.php for the SQLite Database Integration - with the authoritative DB_ENGINE, DB_DIR, and DB_FILE constants - which no other generator does. It also generates the salts on your device.</p>\n</details>\n<details class=\"wpc-faq-item\">\n<summary>How do I set up SQLite with WordPress?</summary>\n<p>Install the SQLite Database Integration plugin, drop the db.php into wp-content, and point the generator at SQLite. It will emit the DB_DIR and DB_FILE constants so your .sqlite database lives under wp-content/database.</p>\n</details>\n<details class=\"wpc-faq-item\">\n<summary>Are the salts generated on my device?</summary>\n<p>Yes. All 8 salts are created in your browser with the Web Crypto API - they are never sent to a server and are unique on each generate.</p>\n</details>\n</section>\n</div>\n</div>\n<div class=\"ad-slot ad-slot--in-content\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-336x280-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"336\" height=\"280\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-336x280-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"336\" height=\"280\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-300x250-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"300\" height=\"250\"></div></template>\n</div>\n</div>\n</div>\n</section>\n<div class=\"ad-slot ad-slot--before-footer\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/u