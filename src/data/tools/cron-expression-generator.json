cusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n<!-- ═══ 3. tool behaviour (cron expression generator) ═══ -->\n<div id=\"crn\" style=\"max-width:var(--content-w)\">\n<main class=\"crn-wrap\">\n<div class=\"cols\">\n<!-- LEFT: builder -->\n<section class=\"crn-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>BUILD</h2><span class=\"line\"></span><span class=\"hint\">min · hour · dom · month · dow</span></div>\n<!-- Beginner explainer: a cron expression is 5 numbers saying WHEN to run a job -->\n<div class=\"intro\">\n<span class=\"ttl\">What is a cron expression?</span>\n<p>A cron expression is <b>5 numbers</b> that say <b>when</b> a job runs, in this order: minute, hour, day-of-month, month, day-of-week. Pick a value for each field below (or leave it on <b>*</b> = every), and the tool reads your schedule back in plain English - no cron knowledge needed.</p>\n<div class=\"leg\">\n<span><code>*</code> every</span>\n<span><code>*/5</code> every 5</span>\n<span><code>1,3,5</code> specific values</span>\n<span><code>1-5</code> a range</span>\n<span><code>1-5/2</code> stepped range</span>\n<span><code>?</code> any</span>\n</div>\n</div>\n<div id=\"fields\"></div>\n<div class=\"msg\" id=\"bldmsg\" hidden></div>\n</section>\n<!-- RIGHT: output -->\n<section class=\"crn-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>EXPRESSION</h2><span class=\"line\"></span></div>\n<div class=\"expr\" id=\"expr\">\n<div class=\"f\" data-f=\"minute\"><span class=\"lab\">Minute</span><span class=\"v\" id=\"v_minute\">*</span></div>\n<div class=\"f\" data-f=\"hour\"><span class=\"lab\">Hour</span><span class=\"v\" id=\"v_hour\">*</span></div>\n<div class=\"f\" data-f=\"dom\"><span class=\"lab\">Day of month</span><span class=\"v\" id=\"v_dom\">*</span></div>\n<div class=\"f\" data-f=\"month\"><span class=\"lab\">Month</span><span class=\"v\" id=\"v_month\">*</span></div>\n<div class=\"f\" data-f=\"dow\"><span class=\"lab\">Day of week</span><span class=\"v\" id=\"v_dow\">*</span></div>\n</div>\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>WHAT IT MEANS</h2><span class=\"line\"></span></div>\n<div class=\"desc\" id=\"desc\"></div>\n<div class=\"tz\" id=\"tz\"></div>\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>NEXT RUNS</h2><span class=\"line\"></span></div>\n<div class=\"runs\" id=\"runs\"></div>\n<div class=\"cap\" id=\"cap\" hidden></div>\n<div class=\"actions\">\n<button class=\"crn-btn crn-p\" id=\"copyExpr\">Copy expression</button>\n<button class=\"crn-btn crn-ghost\" id=\"copyDesc\">Copy description</button>\n</div>\n</section>\n</div>\n<!-- WORDPRESS PANEL -->\n<section class=\"crn-card crn-wp\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>THE WORDPRESS ANGLE</h2><span class=\"line\"></span></div>\n<div class=\"wp-note\" id=\"wpnote\"></div>\n<div class=\"field\"><span class=\"flbl\">Your site URL (for the host-cron command)</span>\n<div class=\"sitegrp\">\n<input type=\"text\" id=\"site\" value=\"https://example.com\" placeholder=\"https://yoursite.com\">\n<input type=\"text\" id=\"wpcron_path\" value=\"/wp-cron.php\" placeholder=\"/wp-cron.php\">\n</div>\n</div>\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>HOST-CRON RECIPE</h2><span class=\"line\"></span><span class=\"hint\">matches your expression exactly</span></div>\n<div class=\"codeblock\" id=\"hostcron\"></div>\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>FIELD-BY-FIELD, FOR WORDPRESS</h2><span class=\"line\"></span></div>\n<div class=\"kv\" id=\"wpmap\"></div>\n<div class=\"reveal\">\n<span class=\"l\">wp-config.php - stop visit-triggered spawning</span>\n<div class=\"codeblock\" id=\"disablewpcron\"></div>\n</div>\n<div class=\"actions\">\n<button class=\"crn-btn crn-p\" id=\"copyHost\">Copy host-cron block</button>\n<button class=\"crn-btn crn-ghost\" id=\"dlBtn\">Download cron.txt</button>\n</div>\n</section>\n<footer class=\"foot\">no server · computed entirely in your browser · cron uses the SERVER timezone, not your device</footer>\n"
