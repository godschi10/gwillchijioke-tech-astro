"2\">2 spaces</option>\n<option value=\"4\">4 spaces</option>\n<option value=\"1\">1 space</option>\n<option value=\"0\">No indent (compact)</option>\n</select>\n<label class=\"gt-chk\"><input type=\"checkbox\" id=\"highlight-toggle\" checked> Highlight</label>\n<button type=\"button\" id=\"btn-format\" class=\"gt-btn gt-btn--primary\">Format</button>\n<button type=\"button\" id=\"btn-validate\" class=\"gt-btn\">Validate</button>\n<button type=\"button\" id=\"btn-minify\" class=\"gt-btn\">Minify</button>\n<button type=\"button\" id=\"btn-sort\" class=\"gt-btn\">Sort keys</button>\n<button type=\"button\" id=\"btn-clear\" class=\"gt-btn gt-btn--ghost\">Clear</button>\n</div>\n<p id=\"json-error\" class=\"gt-error\" role=\"alert\" hidden></p>\n<p id=\"json-warn\" class=\"gt-warn\" hidden></p>\n</section>\n<section class=\"gt-card\">\n<div class=\"gt-sec\"><span class=\"gt-sdot\"></span><h2>OUTPUT</h2><span class=\"gt-line\"></span></div>\n<div class=\"gt-outwrap\">\n<div class=\"gt-field gt-outfield\">\n<label class=\"gt-sronly\" for=\"json-output\">Output</label>\n\t\t\t\t\t\t\t<textarea id=\"json-output\" spellcheck=\"false\" readonly rows=\"12\" placeholder=\"Result appears here…\"></textarea>\n\t\t\t\t\t\t\t<pre id=\"json-hl\" class=\"gt-hl\" aria-hidden=\"true\" hidden></pre>\n\t\t\t\t\t\t</div>\n</div>\n<div class=\"gt-toolbar gt-outactions\">\n<button type=\"button\" id=\"btn-copy\" class=\"gt-btn\">Copy</button>\n<button type=\"button\" id=\"btn-download\" class=\"gt-btn\">Download</button>\n</div>\n<div id=\"json-stats\" class=\"gt-stats2\" aria-live=\"polite\">\n<div class=\"gt-stat-row\" id=\"json-stat-in\"><span class=\"gt-stat-lbl\">Input</span> <span class=\"gt-stat-val\"> - </span></div>\n<div class=\"gt-stat-row\" id=\"json-stat-out\"><span class=\"gt-stat-lbl\">Output</span> <span class=\"gt-stat-val\"> - </span></div>\n</div>\n</section>\n<section class=\"gt-card\" id=\"gt-treecard\" hidden>\n<div class=\"gt-sec\"><span class=\"gt-sdot\"></span><h2 id=\"json-tree-label\">TREE VIEW</h2><span class=\"gt-line\"></span></div>\n<div id=\"json-tree\" class=\"gt-tree\" role=\"group\" aria-labelledby=\"json-tree-label\"></div>\n</section>\n<div class=\"ad-slot ad-slot--in-content\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-336x280-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"336\" height=\"280\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-336x280-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"336\" height=\"280\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-incontent-300x250-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"300\" height=\"250\"></div></template>\n</div>\n</div>\n</div>\n<!-- ═══ 4. related tools ═══ -->\n<section class=\"gt-related\" aria-labelledby=\"gt-related-h\">\n<h2 id=\"gt-related-h\" class=\"gt-related-h\">&gt;_ Related tools</h2>\n<div class=\"gt-related-grid\">\n<a class=\"gt-rel-card\" href=\"%BASE%/tools/schema-generator/\">\n<span class=\"gt-rel-name\">Schema / JSON-LD Generator</span>\n<span class=\"gt-rel-desc\">Turn this JSON into Google-ready structured data.</span>\n</a>\n<a class=\"gt-rel-card\" href=\"%BASE%/tools/sqlite-mysql-converter/\">\n<span class=\"gt-rel-name\">SQLite ⇄ MySQL Converter</span>\n<span class=\"gt-rel-desc\">Convert database dialects in the same paste-and-go style.</span>\n</a>\n<a class=\"gt-rel-card\" href=\"%BASE%/tools/qr-generator/\">\n<span class=\"gt-rel-name\">QR Code Generator</span>\n<span class=\"gt-rel-desc\">Encode any text or URL - same privacy promise.</span>\n</a>\n<a class=\"gt-rel-card\" href=\"%BASE%/tools/password-generator/\">\n<span class=\"gt-rel-name\">Password Generator</span>\n<span class=\"gt-rel-desc\">Strong secrets, generated on-device.</span>\n</a>\n</div>\n</section>\n<!-- ═══ 5. FAQ (visible - mirrors the FAQPage schema) ═══ -->\n<section class=\"gt-faq\" aria-labelledby=\"gt-faq-h\">\n<h2 id=\"gt-faq-h\" class=\"gt-faq-h\">&gt;_ FAQ</h2>\n<details class=\"gt-faq-item\">\n<summary>Does the JSON formatter send my data anywhere?</summary>\n<p>No. Parsing, formatting, validation, minification, sorting, and the tree view all run in your browser with plain JavaScript. There is no server call and no upload - your JSON never leaves your device.</p>\n</details>\n<details class=\"gt-faq-item\">\n<summary>Is the JSON tool free?</summary>\n<p>Yes - completely free, with no sign-up, no usage limits, and no ads injected between you and your data. It ships with the site theme and works offline once the page has loaded.</p>\n</details>\n<details class=\"gt-faq-item\">\n<summary>Does it validate JSON too?</summary>\n<p>Yes. Press Validate and get a strict yes/no plus the exact line and column of the first problem - trailing commas, single quotes, missing brackets, and other common mistakes are all caught.</p>\n</details>\n<details class=\"gt-faq-item\">\n<summary>Why are trailing commas rejected?</summary>\n<p>Strict JSON (RFC 8259) does not allow a comma after the last item in an object or array. JavaScript tolerates it, which is why pasted code often fails here - this tool tells you honestly instead of guessing what you meant.</p>\n</details>\n<details class=\"gt-faq-item\">\n<summary>What is the maximum JSON size I can format?</summary>\n<p>There is no hard limit - the tool formats multi-megabyte documents as fast as your device allows. Files opened from disk are capped at 20 MB to keep the browser tab responsive; paste has no such cap.</p>\n</details>\n</section>\n</div>\n</section>\n<div class=\"ad-slot ad-slot--before-footer\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n</article>\n"
