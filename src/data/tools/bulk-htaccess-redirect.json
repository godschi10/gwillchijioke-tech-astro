=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n<!-- ═══ 3. tool behaviour (bulk 301 redirect workbench) ═══ -->\n<div id=\"brd\" style=\"max-width:var(--content-w)\">\n<main class=\"brd-wrap\">\n<!-- STEP 1: PASTE -->\n<section class=\"brd-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>STEP 1 - Paste old → new URLs</h2><span class=\"line\"></span></div>\n<p class=\"hint\">One pair per line. Separate with comma, tab, semicolon, pipe or 2+ spaces. A header row like &quot;old,new&quot; is skipped automatically.</p>\n<textarea id=\"paste\" spellcheck=\"false\" placeholder=\"/old-url,  /new-url&#010;/contact-us,  /about/contact&#010;/portfolio,  https://example.com/our-work\"></textarea>\n<div class=\"caption\"><span id=\"pastecount\">0 lines</span>\n<button class=\"brd-btn brd-ghost\" id=\"clear\">Clear</button>\n<button class=\"brd-btn brd-ghost\" id=\"loadpaste\">Load paste into table</button>\n<button class=\"brd-btn brd-p\" id=\"addrow\">Add empty row</button>\n</div>\n</section>\n<!-- STEP 2: REVIEW -->\n<section class=\"brd-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>STEP 2 - Review &amp; fix</h2><span class=\"line\"></span><span class=\"stat\" id=\"rescount\">0 redirects</span></div>\n<p class=\"hint\">Every row is shown and validated. Edit a path by tapping it; remove a row with the ×.</p>\n<div class=\"tblwrap\">\n<table class=\"rows\">\n<thead><tr><th class=\"su\">Status</th><th>Old URL</th><th>New URL</th><th class=\"su\"></th></tr></thead>\n<tbody id=\"rowsbody\"></tbody>\n</table>\n<div class=\"empty\" id=\"empty\" hidden>Paste URLs in step 1 - your rows appear here.</div>\n</div>\n</section>\n<!-- STEP 3: OPTIONS -->\n<section class=\"brd-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>STEP 3 - Options &amp; generate</h2><span class=\"line\"></span></div>\n<div class=\"opts\">\n<label class=\"field\"><span class=\"flbl\">Method</span>\n<select id=\"method\">\n<option value=\"mod_rewrite\" selected>RewriteRule (mod_rewrite, regex)</option>\n<option value=\"mod_alias\">Redirect (mod_alias, literal)</option>\n</select></label>\n<label class=\"field\"><span class=\"flbl\">Status</span>\n<select id=\"code\">\n<option value=\"301\" selected>301 Moved Permanently (SEO)</option>\n<option value=\"302\">302 Found (temporary)</option>\n<option value=\"307\">307 Temporary Redirect</option>\n<option value=\"308\">308 Permanent Redirect</option>\n</select></label>\n<label class=\"field\"><span class=\"flbl\">Matching</span>\n<select id=\"match\">\n<option value=\"exact\" selected>Exact path</option>\n<option value=\"prefix\">Prefix (catch anything under it)</option>\n</select></label>\n<label class=\"field\"><span class=\"flbl\">Trailing slash</span>\n<select id=\"slash\">\n<option value=\"optional\" selected>Match with or without</option>\n<option value=\"strict\">Strict (exactly as written)</option>\n</select></label>\n<label class=\"chk\"><input type=\"checkbox\" id=\"caseins\">Case-insensitive match</label>\n<label class=\"chk\"><input type=\"checkbox\" id=\"qschk\">Carry query strings</label>\n</div>\n<div class=\"actions\">\n<button class=\"brd-btn brd-p\" id=\"gen\">Generate redirect block</button>\n</div>\n</section>\n<!-- OUTPUT -->\n<section class=\"brd-card\">\n<div class=\"sec-head\"><span class=\"ic\"></span><h2>OUTPUT - .htaccess redirect block</h2><span class=\"line\"></span><span class=\"stat\" id=\"outstat\">0 chars</span></div>\n<textarea id=\"output\" spellcheck=\"false\" readonly placeholder=\"generated redirect block appears here…\"></textarea>\n<div class=\"actions\">\n<button class=\"brd-btn brd-p\" id=\"copy\">Copy redirects</button>\n<button class=\"brd-btn brd-ghost\" id=\"dl\">Download .htaccess</button>\n</div>\n<div class=\"report\" id=\"report\"></div>\n<div class=\"honest\"><b>Where to put it:</b> paste the generated block ABOVE the WordPress permalink rules in your .htaccess - The [R=301,L] flag stops processing, so rules above permalinks win. Test on a staging URL before going live; a 301 is cached by browsers and search engines, so a wrong redirect is hard to undo.</div>\n</section>\n<footer class=\"foot\">no server · everything computed in your browser · one HTML file</footer>\n"
