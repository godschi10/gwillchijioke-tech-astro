svg>\n<strong class=\"imc-z-title\">Drop images here</strong>\n<span class=\"imc-z-sub\">or tap to browse - PNG · JPG · WebP · select several at once</span>\n</label>\n<label class=\"imc-btn imc-ghost imc-chooseBtn\" id=\"imc-chooseBtn\" for=\"imc-file\">Choose image(s)</label>\n<input type=\"file\" class=\"imc-fileInput\" id=\"imc-file\" accept=\"image/*\" multiple>\n</section>\n<section class=\"imc-card\" id=\"imc-panel\" aria-label=\"Image settings\" hidden>\n<div class=\"imc-ctrl\">\n<div class=\"imc-rowline\">\n<span class=\"imc-lbl\">format</span>\n<div class=\"imc-seg\" role=\"radiogroup\" aria-label=\"Output format\">\n<label><input type=\"radio\" name=\"imc-fmt\" value=\"webp\" checked><span>WebP</span></label>\n<label><input type=\"radio\" name=\"imc-fmt\" value=\"jpeg\"><span>JPEG</span></label>\n<label><input type=\"radio\" name=\"imc-fmt\" value=\"png\"><span>PNG</span></label>\n</div>\n</div>\n<div class=\"imc-rowline\" id=\"imc-qRow\">\n<span class=\"imc-lbl\">quality</span>\n<input class=\"imc-range\" type=\"range\" id=\"imc-q\" min=\"10\" max=\"100\" step=\"1\" value=\"75\" aria-label=\"Quality\">\n<input class=\"imc-number imc-pct-num\" type=\"number\" id=\"imc-qTxt\" min=\"10\" max=\"100\" step=\"1\" value=\"75\" inputmode=\"numeric\" aria-label=\"Quality percentage\">\n<span class=\"imc-val\">%</span>\n</div>\n<div class=\"imc-rowline\">\n<span class=\"imc-lbl\">resize</span>\n<div class=\"imc-seg\" role=\"radiogroup\" aria-label=\"Resize mode\">\n<label><input type=\"radio\" name=\"imc-rmode\" value=\"pct\" checked><span>by %</span></label>\n<label><input type=\"radio\" name=\"imc-rmode\" value=\"px\"><span>exact size</span></label>\n</div>\n</div>\n<!-- #5: type-a-percent input beside the slider - kept both. -->\n<div class=\"imc-rowline\" id=\"imc-pctRow\">\n<span class=\"imc-lbl\">scale</span>\n<input class=\"imc-range\" type=\"range\" id=\"imc-pct\" min=\"1\" max=\"200\" step=\"1\" value=\"100\" aria-label=\"Scale\">\n<input class=\"imc-number imc-pct-num\" type=\"number\" id=\"imc-pctTxt\" min=\"1\" max=\"500\" step=\"1\" value=\"100\" inputmode=\"numeric\" aria-label=\"Scale percentage\">\n<span class=\"imc-val\">%</span>\n</div>\n<div class=\"imc-rowline\" id=\"imc-pxRow\" hidden>\n<span class=\"imc-lbl\">size</span>\n<span class=\"imc-dims\">\n<input class=\"imc-number\" type=\"number\" id=\"imc-wIn\" min=\"1\" step=\"1\" inputmode=\"numeric\" placeholder=\"width\" aria-label=\"Width in pixels\">\n<span class=\"imc-x\" aria-hidden=\"true\">×</span>\n<input class=\"imc-number\" type=\"number\" id=\"imc-hIn\" min=\"1\" step=\"1\" inputmode=\"numeric\" placeholder=\"height\" aria-label=\"Height in pixels\">\n<label class=\"imc-lock\"><input type=\"checkbox\" id=\"imc-lockAspect\" checked><span>lock aspect</span></label>\n</span>\n</div>\n</div>\n<div class=\"imc-actions\">\n<label class=\"imc-btn imc-ghost\" for=\"imc-file\">Add more images</label>\n</div>\n</section>\n<section class=\"imc-card imc-card--results\" id=\"imc-resultscard\" hidden>\n<div class=\"imc-sec\"><span class=\"imc-sdot\"></span><h2>RESULTS</h2><span class=\"imc-line\"></span></div>\n<!-- #1: Total savings summary - live aggregate across every compressed image -->\n<div class=\"imc-summary\" id=\"imc-summary\" hidden>\n<div class=\"imc-summary__stat\">\n<span class=\"imc-k\">total original</span>\n<span class=\"imc-v\" id=\"imc-sumOrig\"> - </span>\n</div>\n<span class=\"imc-arr\" aria-hidden=\"true\">→</span>\n<div class=\"imc-summary__stat\">\n<span class=\"imc-k\">total compressed</span>\n<span class=\"imc-v\" id=\"imc-sumNew\"> - </span>\n</div>\n<span class=\"imc-badge imc-summary__badge\" id=\"imc-sumBadge\"> - </span>\n<p class=\"imc-summary__note\">Metadata (EXIF, comments) is stripped during re-encoding - nothing is uploaded.</p>\n</div>\n<!-- #1: Download all - sits ABOVE the image cards (King: \"should come before the images\") -->\n<div class=\"imc-actions\" id=\"imc-dlAllWrap\" hidden>\n<button type=\"button\" class=\