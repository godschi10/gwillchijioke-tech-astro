s=\"wlda-lbl\">or</span>\n<input type=\"file\" id=\"fileInput\" accept=\".log,.txt,text/plain\">\n<label class=\"wlda-btn wlda-ghost\" for=\"fileInput\">Choose debug.log file</label>\n<span id=\"fileName\" class=\"wlda-source-note\"></span>\n</div>\n<div class=\"wlda-actions\">\n<button class=\"wlda-btn wlda-primary\" id=\"analyzeBtn\">Analyze log</button>\n<button class=\"wlda-btn wlda-ghost\" id=\"clearBtn\">Clear</button>\n<span id=\"srcNote\" class=\"wlda-source-note\"></span>\n</div>\n</section>\n<div class=\"wlda-prog\" id=\"prog\" hidden>\n<div class=\"wlda-ptext\" id=\"progText\">parsing lines…</div>\n<div class=\"wlda-bar\"><i id=\"progBar\"></i></div>\n</div>\n<div class=\"wlda-msg\" id=\"msg\" role=\"alert\" hidden></div>\n<!-- dashboard -->\n<section class=\"wlda-card wlda-dash\" id=\"dash\" hidden>\n<div class=\"wlda-sec\"><span class=\"wlda-sdot\"></span><h2>ANALYSIS</h2><span class=\"wlda-line\"></span></div>\n<div class=\"wlda-statline\">\n<span><span class=\"wlda-big\" id=\"totalN\">0</span> <span class=\"wlda-sub\" id=\"totalSub\">total</span></span>\n<span><span class=\"wlda-big\" id=\"groupN\">0</span> <span class=\"wlda-sub\">repeated groups</span></span>\n<span><span class=\"wlda-cap\">level breakdown</span></span>\n</div>\n<div class=\"wlda-chips\" id=\"chips\"></div>\n<div class=\"wlda-toolbar\">\n<label class=\"wlda-search\"><input id=\"search\" type=\"search\" placeholder=\"search by message / file / line…\"></label>\n<button class=\"wlda-btn wlda-ghost\" id=\"rawToggle\">show raw log</button>\n</div>\n<div id=\"groups\"></div>\n<div class=\"wlda-raw-list\" id=\"rawList\" hidden></div>\n<button class=\"wlda-btn wlda-ghost wlda-loadmore\" id=\"moreBtn\" hidden>load more groups</button>\n<div class=\"wlda-actions\">\n<button class=\"wlda-btn wlda-ghost\" id=\"copyBtn\">Copy report</button>\n<button class=\"wlda-btn wlda-primary\" id=\"dlBtn\">Download report (.md)</button>\n</div>\n</section>\n<footer class=\"wlda-foot\">no server · no upload