  "breadcrumb": "<nav class=\"breadcrumb\" style=\"margin-bottom:var(--sp-4)\" aria-label=\"Breadcrumb\">\n<ol class=\"breadcrumb-list\">\n<li><a href=\"%BASE%/\" class=\"bc-home-link\"><span class=\"bc-prompt\">&gt;_</span>Home</a></li>\n<li><span class=\"breadcrumb-current\" aria-current=\"page\">Contact</span></li>\n</ol>\n</nav>",
  "body": "\n<article class=\"page-contact\" itemscope itemtype=\"https://schema.org/ContactPage\">\n<section class=\"section-sm\" style=\"padding-top:var(--sp-6);padding-bottom:0;position:relative\">\n<div class=\"wrap\">\n<nav class=\"breadcrumb\" style=\"margin-bottom:var(--sp-4)\" aria-label=\"Breadcrumb\">\n<ol class=\"breadcrumb-list\">\n<li><a href=\"%BASE%/\" class=\"bc-home-link\"><span class=\"bc-prompt\">&gt;_</span>Home</a></li>\n<li><span class=\"breadcrumb-current\" aria-current=\"page\">Contact</span></li>\n</ol>\n</nav>\n<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://gwillchijioke.qzz.io/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Contact\",\"item\":\"https://gwillchijioke.qzz.io/contact/\"}]}</script>\n<div class=\"about-hero\">\n<p class=\"label label-green\">>_ /contact</p>\n<div class=\"about-intro\">\n<div class=\"about-text\">\n<h1 style=\"font-size:clamp(28px,4vw,44px);font-weight:800;line-height:1.1;margin:16px 0;letter-spacing:-.03em\">I read every message personally.</h1>\n<p style=\"font-size:17px;color:var(--mid);line-height:1.7;max-width:56ch\">\n\t\t\t\t\t\t\tWhether you have a question about a guide, want to suggest something, or just want to say hi - pick a category below and I&#039;ll get back to you.\t\t\t\t\t\t</p>\n</div>\n</div>\n</div>\n<!-- ═══ 3. ad slot ═══ -->\n<div class=\"ad-slot ad-slot--leaderboard\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n<div class=\"contact-layout\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:var(--sp-10);margin-top:var(--sp-6)\">\n<!-- Form -->\n<div class=\"contact-form-col\">\n<h2 class=\"contact-form-heading\" style=\"font-size:15px;font-weight:700;font-family:var(--font-mono);color:var(--green);margin:0 0 var(--sp-4);letter-spacing:.02em\">Send a message</h2>\n<form\n\tclass=\"gwill-form gwill-form--routed\"\n\tmethod=\"post\"\n\taction=\"%BASE%/wp-admin/admin-ajax.php\"\n\tnovalidate\n>\n<div class=\"gwill-honey\" aria-hidden=\"true\">\n<label for=\"hp_gwill-routed-1\">Leave this blank</label>\n<input type=\"text\" name=\"gwill_hp_gwill-routed-1\" id=\"hp_gwill-routed-1\" tabindex=\"-1\" autocomplete=\"off\">\n</div>\n<input type=\"hidden\" name=\"action\"        value=\"gwill_contact_form\">\n<input type=\"hidden\" name=\"gwill_form_id\" value=\"routed\">\n<div class=\"gwill-form__field\">\n<label for=\"type_gwill-routed-1\">\n\t\t\tWhat&#039;s this about?\t\t\t<span class=\"gwill-form__required\" aria-hidden=\"true\">*</span>\n</label>\n<select id=\"type_gwill-routed-1\" name=\"gwill_inquiry_type\" required>\n<option value=\"\">Choose…</option>\n<option value=\"press\">Press &amp; Media</option>\n<option value=\"partnership\">Brand Partnerships</option>\n<option value=\"reader\">Reader Question</option>\n<option value=\"support\">Technical Support</option>\n<option value=\"general\">General</option>\n</select>\n</div>\n<div class=\"gwill-form__row gwill-form__row--2col\">\n<div class=\"gwill-form__field\">\n<label for=\"name_gwill-routed-1\">\n\t\t\t\tName\t\t\t\t<span class=\"gwill-form__required\" aria-hidden=\"true\">*</span>\n</label>\n<input type=\"text\" id=\"name_gwill-routed-1\" name=\"gwill_name\" required autocomplete=\"name\">\n</div>\n<div class=\"gwill-form__field\">\n<label for=\"email_gwill-routed-1\">\n\t\t\t\tEmail\t\t\t\t<span class=\"gwill-form__required\" aria-hidden=\"true\">*</span>\n</label>\n<input type=\"email\" id=\"email_gwill-routed-1\" name=\"gwill_email\" required autocomplete=\"email\">\n</div>\n</div>\n<div class=\"gwill-form__field\">\n<label for=\"message_gwill-routed-1\">\n\t\t\tMessage\t\t\t<span class=\"gwill-form__required\" aria-hidden=\"true\">*</span>\n</label>\n<textarea id=\"message_gwill-routed-1\" name=\"gwill_message\" rows=\"5\" required></textarea>\n</div>\n<div class=\"gwill-form__actions\">\n<!-- ═══ 2. submit ═══ -->\n<button type=\"submit\" class=\"gwill-form__submit\">\n<span class=\"gwill-form__submit-text\">Send a message</span>\n<span class=\"gwill-form__submit-loading\" aria-hidden=\"true\">Sending…</span>\n</button>\n</div>\n<div class=\"gwill-form__status\" role=\"alert\" aria-live=\"polite\"></div>\n</form>\n</div>\n<!-- ═══ 4. contact info ═══ -->\n<!-- Sidebar info -->\n<div class=\"contact-info-col\" style=\"display:flex;flex-direction:column;gap:var(--sp-6)\">\n<div class=\"contact-card\" style=\"background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:var(--sp-6)\">\n<h3 style=\"font-size:13px;font-weight:700;font-family:var(--font-mono);color:var(--green);margin:0 0 var(--sp-3)\">>_ email</h3>\n<p style=\"font-size:14px;color:var(--mid);margin:0\">\n<a href=\"mailto:hello@gwillchijioke.com\" style=\"color:var(--text);text-decoration:underline;text-decoration-color:var(--border);text-underline-offset:3px\">hello@gwillchijioke.com</a>\n</p>\n</div>\n<div class=\"contact-card\" style=\"background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:var(--sp-6)\">\n<h3 style=\"font-size:13px;font-weight:700;font-family:var(--font-mono);color:var(--green);margin:0 0 var(--sp-3)\">>_ response time</h3>\n<p style=\"font-size:14px;color:var(--mid);margin:0\">\n\t\t\t\t\t\t\tI reply within <strong>24-48 hours</strong> on weekdays. Weekends may take a little longer.\t\t\t\t\t\t</p>\n</div>\n<div class=\"contact-card\" style=\"background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:var(--sp-6)\">\n<h3 style=\"font-size:13px;font-weight:700;font-family:var(--font-mono);color:var(--green);margin:0 0 var(--sp-3)\">&gt;_ before you write</h3>\n<ul style=\"font-size:14px;color:var(--mid);margin:0;padding-left:var(--sp-5);line-height:1.8\">\n<li>Check the <a href=\"/search/\">search bar</a> first - your answer may already exist.</li>\n<li>Be specific about your device, OS version, and what you tried.</li>\n<li>I don&rsquo;t accept guest posts or sponsored placements - see <a href=\"/disclaimer/\">disclaimer</a>.</li>\n</ul>\n</div>\n</div>\n</div>\n</div>\n</section>\n<div class=\"ad-slot ad-slot--before-footer\">\n<div class=\"ad-slot__spinner\" aria-hidden=\"true\">\n<svg aria-hidden=\"true\" focusable=\"false\" class=\"ad-spinner\" viewBox=\"0 0 24 24\" width=\"26\" height=\"26\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\">\n<circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".25\"/>\n<path d=\"M21 12a9 9 0 0 0-9-9\"/>\n</svg>\n<span class=\"ad-slot__spinner-text\">Ad loading…</span>\n</div>\n<div class=\"ad-slot__content\">\n<template class=\"ad-variant\" data-device=\"desktop\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"tablet\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-728x90-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"728\" height=\"90\"></div></template>\n<template class=\"ad-variant\" data-device=\"mobile\"><div class=\"gwill-ad-banner\"><img src=\"%BASE%/wp-content/uploads/2026/08/gwill-ad-leaderboard-320x100-1.jpg\" alt=\"Advertisement\" loading=\"lazy\" width=\"320\" height=\"100\"></div></template>\n</div>\n</div>\n</article>\n"
