---
import CapturedPage from '../../../components/CapturedPage.astro';

export function getStaticPaths() {
  const modules = import.meta.glob('../../../data/pagination/author-*.json', { eager: true });
  return Object.values(modules).map((m: any) => {
    const data = m.default ?? m;
    return {
      params: { author: 'gwill', page: data.route.replace(/^author\/gwill\//, '') },
      props: { data },
    };
  });
}

const { data } = Astro.props as any;
---

<CapturedPage data={data} />
