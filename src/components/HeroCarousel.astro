---
// Hero carousel — ported from the LIVE served markup (tech-truth/home.html).
// Slide anatomy, class names, aria roles and the inline category colour vars are the
// theme's own. Autoplay/dots/arrows are driven by the theme's hero-carousel.js (added P1.2).
import { local, localSrcset } from '../lib/media';

interface Slide {
  href: string;
  catHref?: string;
  title: string;
  deck?: string;
  cat?: string;
  img?: string;
  srcset?: string;
  style?: string;
  author?: string;
  read?: string;
  dateISO?: string;
  dateText?: string;
}

interface Props {
  slides: Slide[];
}
const { slides } = Astro.props;
---

<section class="hero-carousel" id="hero-carousel" aria-label="Featured posts" aria-roledescription="carousel" aria-live="polite">
  <div class="wrap">
    <div class="hc-track">
      {
        slides.map((s, i) => (
          <div
            class={`hc-slide${i === 0 ? ' is-active' : ''}`}
            data-slide={i}
            role="group"
            aria-roledescription="slide"
            aria-label={`Slide ${i + 1} of ${slides.length}`}
          >
            <div class="hc-media cat-tint has-img" style={s.style}>
              {s.img && (
                <img
                  width="1024"
                  height="683"
                  src={local(s.img)}
                  class="hc-img wp-post-image"
                  alt={s.cat ? `${s.cat}: ${s.title}` : s.title}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  srcset={localSrcset(s.srcset || '') || undefined}
                  sizes="(max-width: 1024px) 100vw, 1024px"
                />
              )}
              <div class="hc-scrim" aria-hidden="true" />
            </div>
            <div class="hc-body">
              {s.cat && <a href={local(s.catHref || '#')} class="badge badge-cat" style={s.style}>{s.cat}</a>}
              <h2 class="hc-title"><a href={local(s.href)}>{s.title}</a></h2>
              {s.deck && <p class="hc-deck">{s.deck}</p>}
              <div class="hc-meta">
                <span>{s.author}</span><span class="hc-dot" aria-hidden="true" />
                <span>{s.read}</span><span class="hc-dot" aria-hidden="true" />
                {s.dateISO ? <time datetime={s.dateISO}>{s.dateText}</time> : <span>{s.dateText}</span>}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div class="hc-controls" data-gwill-hc-controls>
      <button type="button" class="hc-arrow" data-hc-prev aria-label="Previous featured post">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
      </button>
      <div class="hc-dots" role="tablist" aria-label="Featured post slides"></div>
      <button type="button" class="hc-arrow" data-hc-next aria-label="Next featured post">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
      </button>
      <button type="button" class="hc-arrow hc-pause" data-hc-toggle aria-pressed="false" aria-label="Pause carousel autoplay">
        <svg class="hc-pause-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" stroke="none" aria-hidden="true"><rect x="7" y="6" width="3.5" height="12" rx="1" /><rect x="13.5" y="6" width="3.5" height="12" rx="1" /></svg>
        <svg class="hc-play-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" stroke="none" aria-hidden="true" style="display:none"><path d="M8 5.5v13l11-6.5z" /></svg>
      </button>
    </div>
    <div class="hc-progress" aria-hidden="true"><span class="hc-progress-fill"></span></div>
  </div>
</section>
