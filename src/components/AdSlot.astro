---
// Ad slot — shell + creatives copied from the LIVE served markup (tech-truth/home.html).
//
// The theme fills slots from inc/ad-slots.php with per-device <template class="ad-variant">
// banners; scripts/sticky-ad.js promotes the matching one. Copying the creatives keeps the
// slots faithful instead of collapsing them, and the same shell accepts new code at deploy.
import adSlots from '../data/ad-slots.json';
import { BASE_NS } from '../lib/url';

interface Props {
  variant?: 'leaderboard' | 'before-footer' | 'menu' | 'sticky' | 'in-content' | 'sidebar';
  filled?: boolean;
}
const { variant = 'leaderboard', filled = false } = Astro.props;
const templates = (adSlots as Record<string, { device: string; html: string }[]>)[variant] ?? [];
const rendered = templates.map((t) => ({ device: t.device, html: t.html.replaceAll('%BASE%', BASE_NS) }));
const classes = ['ad-slot', `ad-slot--${variant}`, filled ? 'ad-slot--filled' : ''].filter(Boolean).join(' ');
---

<div class={classes}>
  <div class="ad-slot__spinner" aria-hidden="true">
    <svg aria-hidden="true" focusable="false" class="ad-spinner" viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
      <circle cx="12" cy="12" r="9" opacity=".25" /><path d="M21 12a9 9 0 0 0-9-9" />
    </svg>
    <span class="ad-slot__spinner-text">Ad loading…</span>
  </div>
  <div class="ad-slot__content">
    {
      rendered.map((t) => (
        <template class="ad-variant" data-device={t.device} set:html={t.html} />
      ))
    }
  </div>
</div>
